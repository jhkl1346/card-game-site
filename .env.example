# 이 파일은 예시입니다. 복사해서 .env 로 만든 뒤 값을 채우세요.
# 실제 값이 들어간 .env 는 절대 커밋하지 않습니다.

# ── 서버 ──────────────────────────────
NODE_ENV=development
PORT=3001

# 프론트엔드 주소 (CORS 허용 대상, 쉼표로 여러 개 가능)
CLIENT_ORIGIN=http://localhost:5173

# ── DB ────────────────────────────────
# 로컬 개발: SQLite 파일 경로
# 배포: 외부 무료 PostgreSQL 접속 문자열 (호스팅 환경변수/GitHub Secrets에만 저장)
DATABASE_URL=

# ── 인증 ──────────────────────────────
# 세션 토큰 서명/해시용 비밀 값 (충분히 긴 무작위 문자열)
SESSION_SECRET=

# 세션 쿠키 만료 (일)
SESSION_TTL_DAYS=30

# ── 프론트엔드 (Vite) ──────────────────
VITE_SERVER_URL=http://localhost:3001
