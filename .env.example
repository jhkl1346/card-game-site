# 이 파일은 예시입니다. 복사해서 .env 로 만든 뒤 값을 채우세요.
# 실제 값이 들어간 .env 는 절대 커밋하지 않습니다.

# ── 서버 ──────────────────────────────
NODE_ENV=development
PORT=3001

# 프론트엔드 주소 (프론트와 API를 서로 다른 도메인에 배포할 때만 CORS 허용 대상으로 사용, 9단계에서 확정)
CLIENT_ORIGIN=http://localhost:5173

# ── DB ────────────────────────────────
# 비워 두면: 로컬 PGlite 파일(apps/server/data/pglite, 설치 불필요)
# pglite:경로 → 지정한 폴더의 PGlite / memory:// → 메모리(종료하면 사라짐)
# 배포: 외부 무료 PostgreSQL 접속 문자열 postgres://... (호스팅 환경변수/GitHub Secrets에만 저장)
DATABASE_URL=

# ── 인증 ──────────────────────────────
# 리버스 프록시(호스팅) 뒤에서 실행할 때 true: X-Forwarded-For로 접속 IP를 확인 (로그인 실패 제한에 사용)
# 세션 만료·잠금 시간 같은 숫자는 apps/server/src/config/auth.ts 의 AuthConfig에서 바꾼다
TRUST_PROXY=false

# ── 프론트엔드 (Vite) ──────────────────
VITE_SERVER_URL=http://localhost:3001
