{
  "name": "@card-game/server",
  "version": "0.1.0",
  "private": true,
  "description": "게임 서버 (Node.js + Socket.IO)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "sim:stud7": "tsx --conditions=source scripts/sim-stud7.ts",
    "sim:holdem": "tsx --conditions=source scripts/sim-holdem.ts",
    "sim:hula": "tsx --conditions=source scripts/sim-hula.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@card-game/game-core": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cookie": "^11.1.5",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
